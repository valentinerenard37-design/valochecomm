<script>
/* Enquête de satisfaction — soirée aeconomia du 5 novembre */

/* ▼▼▼ COLLEZ ICI L’ADRESSE GOOGLE APPS SCRIPT (elle se termine par /exec), entre les guillemets ▼▼▼ */
var ENDPOINT = "";
/* ▲▲▲ Tant qu’elle est vide, la page fonctionne mais n’enregistre aucune réponse. ▲▲▲ */

var STORAGE_KEY = "aeconomia-enquete-5nov";
var TOTAL = 4;

var app = document.getElementById("app");
var form = document.getElementById("survey");
var steps = Array.prototype.slice.call(document.querySelectorAll(".step"));
var current = 1;

/* ----- Notes par moment : boutons 1 à 5 générés ----- */
document.querySelectorAll(".mini").forEach(function (box) {
  var name = box.getAttribute("data-name");
  for (var i = 1; i <= 5; i++) box.appendChild(option(name, String(i), String(i), i + " sur 5"));
  var na = box.getAttribute("data-na");
  if (na) {
    var l = option(name, na, na.toLowerCase(), na);
    l.className = "na";
    box.appendChild(l);
  }
});
function option(name, value, text, aria) {
  var label = document.createElement("label");
  var input = document.createElement("input");
  input.type = "radio"; input.name = name; input.value = value;
  input.setAttribute("aria-label", aria);
  var span = document.createElement("span");
  span.textContent = text;
  label.appendChild(input); label.appendChild(span);
  return label;
}

/* ----- Nom ou anonyme ----- */
var ident = document.getElementById("ident");
form.querySelectorAll('input[name="mode"]').forEach(function (r) {
  r.addEventListener("change", function () {
    var named = r.value === "Nominatif" && r.checked;
    ident.hidden = !named;
    if (named) document.getElementById("nom").focus();
    clearError(1);
  });
});

/* ----- Goodies : deux choix maximum, « Pas de cadeau » exclusif, « Autre » ouvre un champ ----- */
var goodies = document.getElementById("goodies");
var goodiesOther = document.getElementById("goodies-other");
goodies.addEventListener("change", function (e) {
  var boxes = goodies.querySelectorAll("input");
  var none = goodies.querySelector("[data-none]");
  if (e.target === none && none.checked) {
    boxes.forEach(function (b) { if (b !== none) b.checked = false; });
  } else if (e.target !== none && e.target.checked) {
    none.checked = false;
  }
  var max = parseInt(goodies.getAttribute("data-max"), 10);
  var count = goodies.querySelectorAll("input:checked:not([data-none])").length;
  boxes.forEach(function (b) {
    if (b.hasAttribute("data-none")) return;
    b.disabled = !b.checked && count >= max;
  });
  var other = goodies.querySelector("[data-other]");
  goodiesOther.hidden = !other.checked;
  if (other.checked && e.target === other) document.getElementById("goodies_autre").focus();
});

/* ----- Navigation entre les étapes ----- */
form.addEventListener("click", function (e) {
  if (e.target.hasAttribute("data-next")) {
    if (validate(current)) show(current + 1);
  } else if (e.target.hasAttribute("data-prev")) {
    show(current - 1);
  }
});

function show(n, initial) {
  current = Math.max(1, Math.min(TOTAL, n));
  steps.forEach(function (s) {
    var on = Number(s.getAttribute("data-step")) === current;
    s.hidden = !on;
    s.classList.toggle("is-entering", on);
  });
  app.setAttribute("data-step", String(current));
  document.querySelectorAll(".progress li").forEach(function (li) {
    var i = Number(li.getAttribute("data-i"));
    li.classList.toggle("is-done", i < current);
    li.classList.toggle("is-current", i === current);
    if (i === current) li.setAttribute("aria-current", "step"); else li.removeAttribute("aria-current");
  });
  if (initial) return;
  window.scrollTo({ top: 0, behavior: reducedMotion() ? "auto" : "smooth" });
  var title = steps[current - 1].querySelector("h2");
  if (title) { title.setAttribute("tabindex", "-1"); title.focus({ preventScroll: true }); }
}

/* ----- Vérifications ----- */
function validate(n) {
  clearError(n);
  if (n === 1) {
    var mode = form.querySelector('input[name="mode"]:checked');
    if (!mode) return fail(1, "Choisissez de répondre avec votre nom ou anonymement.", "q-mode");
    if (mode.value === "Nominatif" && !document.getElementById("nom").value.trim()) {
      return fail(1, "Indiquez votre prénom et votre nom, ou choisissez de répondre anonymement.", "ident");
    }
  }
  if (n === 2 && !form.querySelector('input[name="note_globale"]:checked')) {
    return fail(2, "Donnez une note globale à la soirée pour continuer.", "q-globale");
  }
  return true;
}
function fail(n, message, id) {
  var step = steps[n - 1];
  step.querySelector(".err").textContent = message;
  var el = document.getElementById(id);
  if (el) {
    el.classList.add("is-invalid");
    el.scrollIntoView({ behavior: reducedMotion() ? "auto" : "smooth", block: "center" });
  }
  return false;
}
function clearError(n) {
  var step = steps[n - 1];
  step.querySelector(".err").textContent = "";
  step.querySelectorAll(".is-invalid").forEach(function (el) { el.classList.remove("is-invalid"); });
}
form.addEventListener("change", function () { clearError(current); });

/* ----- Envoi ----- */
form.addEventListener("submit", function (e) {
  e.preventDefault();
  if (!validate(1)) return show(1);
  if (!validate(2)) return show(2);

  var data = { date: new Date().toISOString() };
  new FormData(form).forEach(function (value, key) {
    value = String(value).trim();
    if (!value) return;
    data[key] = data[key] ? data[key] + ", " + value : value;
  });
  if (data.mode === "Anonyme") { delete data.nom; delete data.structure; }
  if (!/Autre/.test(data.goodies || "")) delete data.goodies_autre;

  var btn = document.getElementById("submit");
  var err = steps[TOTAL - 1].querySelector(".err");

  if (!ENDPOINT) { finish(data); return; }

  btn.disabled = true;
  btn.textContent = "Envoi en cours…";
  fetch(ENDPOINT, { method: "POST", mode: "no-cors", body: new URLSearchParams(data) })
    .then(function () { finish(data); })
    .catch(function () {
      btn.disabled = false;
      btn.textContent = "Envoyer mon avis";
      err.textContent = "L’envoi n’a pas abouti. Vérifiez votre connexion puis réessayez.";
    });
});

function finish(data) {
  var first = data.nom ? data.nom.split(/\s+/)[0] : "";
  try { localStorage.setItem(STORAGE_KEY, first || "1"); } catch (e) {}
  showThanks(first);
}
function showThanks(first) {
  form.hidden = true;
  document.querySelector(".progress").hidden = true;
  app.setAttribute("data-step", "done");
  document.getElementById("thanks-title").textContent = first ? "Merci " + first + "\u202F!" : "Merci\u202F!";
  document.getElementById("thanks").hidden = false;
  window.scrollTo({ top: 0, behavior: reducedMotion() ? "auto" : "smooth" });
}

function reducedMotion() {
  return window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
}

show(1, true);

/* ----- Déjà répondu sur cet appareil ----- */
try {
  var saved = localStorage.getItem(STORAGE_KEY);
  if (saved) showThanks(saved === "1" ? "" : saved);
} catch (e) {}

</script>
