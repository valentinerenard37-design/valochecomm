<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Votre avis sur la soirée du 5 novembre · aeconomia</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
/* Enquête de satisfaction — soirée aeconomia du 5 novembre
   L’identité de la soirée (fond encre, tickets papier) reste la même en mode clair et sombre. */

:root{
  --ink:#1A1816;
  --ink-2:#24211E;
  --paper:#F5F5F5;
  --text:#1A1816;
  --soft:#4D4943;
  --rule:#CFCAC2;
  --green:#ADE83C;
  --on-ink:#FFFFFF;
  --ink-soft:#BCB6AC;
  --ink-faint:#948E84;
  --ink-rule:#3D3934;
  --error:#9B2C1F;
  --serif:'Cormorant Garamond', Georgia, 'Times New Roman', serif;
  color-scheme:dark;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top, 0px);
  padding-bottom:env(safe-area-inset-bottom, 0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){ --ink:#1A1816; --paper:#F5F5F5; --text:#1A1816; }
}
:root[data-theme="dark"]{ --ink:#1A1816; --paper:#F5F5F5; --text:#1A1816; }

*,*::before,*::after{ box-sizing:border-box; }
html{ background:var(--ink); scroll-padding-top:env(safe-area-inset-top, 0px); }
body{
  margin:0; background:var(--ink); color:var(--on-ink);
  font-family:var(--serif); font-variant-numeric:lining-nums;
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
}
[hidden]{ display:none !important; }
.sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }

.page{ max-width:620px; margin:0 auto; padding:40px 20px 56px; }

/* ---------- En-tête ---------- */
.brand{ margin:0; text-align:center; font-size:24px; font-style:italic; font-weight:500; letter-spacing:.3px; }
.hero{ text-align:center; margin-top:34px; }
.hero h1{ margin:0; font-size:clamp(44px, 12vw, 64px); line-height:1; font-style:italic; font-weight:500; }
.lead{ margin:18px auto 0; max-width:420px; font-size:20px; line-height:1.4; color:var(--ink-soft); }
.meta{ margin:18px 0 0; font-size:16px; font-style:italic; color:var(--green); }
.page:not([data-step="1"]) .hero{ display:none; }

/* ---------- Progression ---------- */
.progress{ margin:34px 0 0; }
.page:not([data-step="1"]) .progress{ margin-top:24px; }
.progress ol{ display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; margin:0; padding:0; list-style:none; }
.progress li{
  position:relative; padding-top:12px; font-size:15px; font-style:italic; color:var(--ink-faint);
  transition:color .25s;
}
.progress li::before{
  content:""; position:absolute; top:0; left:0; right:0; height:3px; border-radius:3px;
  background:var(--ink-rule); transition:background .25s;
}
.progress li.is-done{ color:var(--ink-soft); }
.progress li.is-done::before{ background:var(--ink-soft); }
.progress li.is-current{ color:var(--on-ink); }
.progress li.is-current::before{ background:var(--green); }

/* ---------- Ticket ---------- */
.step,.thanks{ margin-top:22px; }
.ticket{ background:var(--paper); color:var(--text); border-radius:20px; overflow:hidden; }
.step.is-entering .ticket{ animation:enter .35s ease-out both; }
@keyframes enter{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }

.stub{ display:flex; align-items:center; gap:20px; padding:28px 32px 24px; }
.num{
  flex:none; width:64px; text-align:center; font-size:60px; line-height:.9;
  font-style:italic; font-weight:500; color:var(--text);
  border-right:1px solid var(--rule); padding-right:18px;
}
.stub h2:focus{ outline:none; }
.stub h2{ margin:0; font-size:34px; line-height:1.05; font-style:italic; font-weight:500; }
.stub p{ margin:4px 0 0; font-size:17px; line-height:1.35; font-style:italic; color:var(--soft); }

.perf{ display:flex; align-items:center; height:28px; }
.perf::before,.perf::after{ content:""; flex:none; width:14px; height:28px; background:var(--ink); }
.perf::before{ border-radius:0 14px 14px 0; }
.perf::after{ border-radius:14px 0 0 14px; }
.perf span{ flex:1; margin:0 12px; border-top:2px dashed var(--rule); }

.body{ padding:6px 32px 30px; }
.body.center{ text-align:center; padding:42px 32px 44px; }

/* ---------- Questions ---------- */
fieldset{ border:0; margin:0; padding:0; min-width:0; }
.q{ margin-top:26px; }
.q legend,.q .label{ display:block; padding:0; font-size:20px; line-height:1.3; font-weight:600; color:var(--text); }
.hint{ margin:3px 0 0; font-size:16px; font-style:italic; color:var(--soft); }
.opt{ font-weight:400; font-style:italic; font-size:16px; color:var(--soft); white-space:nowrap; }

input[type=radio],input[type=checkbox]{ position:absolute; opacity:0; width:1px; height:1px; margin:0; }

/* Cartes de choix (étape 1) */
.cards{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px; }
.card span{
  display:block; height:100%; padding:16px 18px; border:1px solid var(--rule); border-radius:14px;
  cursor:pointer; background:#FFFFFF; transition:border-color .15s, background .15s, color .15s;
}
.card strong{ display:block; font-size:20px; font-weight:600; }
.card em{ display:block; margin-top:3px; font-size:15px; line-height:1.3; color:var(--soft); }
.card input:checked + span{ background:var(--ink); border-color:var(--ink); color:var(--on-ink); }
.card input:checked + span em{ color:var(--ink-soft); }

/* Échelle 1 à 5 */
.scale{ display:grid; grid-template-columns:repeat(5, 1fr); gap:8px; margin-top:12px; }
.scale span{
  display:flex; align-items:center; justify-content:center; height:50px;
  border:1px solid var(--text); border-radius:99px; font-size:22px; font-weight:500; cursor:pointer;
  transition:background .15s, color .15s;
}
.scale input:checked + span{ background:var(--ink); color:var(--on-ink); }

/* Recommandation 0 à 10 */
.nps{ display:grid; grid-template-columns:repeat(11, 1fr); gap:4px; margin-top:12px; }
.nps span{
  display:flex; align-items:center; justify-content:center; height:42px;
  border:1px solid var(--rule); border-radius:10px; background:#FFFFFF; font-size:18px; cursor:pointer;
  transition:background .15s, color .15s, border-color .15s;
}
.nps input:checked + span{ background:var(--ink); border-color:var(--ink); color:var(--on-ink); }

.ends{ display:flex; justify-content:space-between; margin-top:6px; font-size:15px; font-style:italic; color:var(--soft); }

/* Notes par moment */
.moments{ margin-top:12px; border-top:1px solid var(--rule); }
.moment{ display:grid; grid-template-columns:1fr auto; gap:10px 14px; align-items:center; padding:13px 0; border-bottom:1px solid var(--rule); }
.moment .name{ font-size:19px; line-height:1.25; }
.moment small{ display:block; font-size:15px; font-style:italic; color:var(--soft); }
.mini{ display:flex; gap:5px; flex-wrap:wrap; }
.mini span{
  display:flex; align-items:center; justify-content:center; min-width:36px; height:36px; padding:0 2px;
  border:1px solid var(--rule); border-radius:99px; background:#FFFFFF; font-size:17px; cursor:pointer;
  transition:background .15s, color .15s, border-color .15s;
}
.mini .na span{ padding:0 12px; font-size:14px; font-style:italic; }
.mini input:checked + span{ background:var(--ink); border-color:var(--ink); color:var(--on-ink); }

/* Pastilles */
.chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.chips span{
  display:inline-block; padding:10px 16px; border:1px solid var(--text); border-radius:99px;
  font-size:17px; line-height:1.15; cursor:pointer; transition:background .15s, color .15s, opacity .15s;
}
.chips input:checked + span{ background:var(--ink); color:var(--on-ink); }
.chips input:disabled + span{ opacity:.35; cursor:default; }

/* Champs texte */
input[type=text],textarea{
  display:block; width:100%; margin-top:10px; padding:12px 14px;
  border:1px solid var(--rule); border-radius:12px; background:#FFFFFF; color:var(--text);
  font-family:var(--serif); font-size:18px; line-height:1.4;
}
textarea{ min-height:100px; resize:vertical; }
.reveal{ margin-top:4px; }
.is-invalid input[type=text],.is-invalid .scale span,.is-invalid .card span{ border-color:var(--error); }

/* Focus clavier */
input:focus-visible + span,
input[type=text]:focus-visible,textarea:focus-visible,
button:focus-visible,a:focus-visible{ outline:2px solid var(--green); outline-offset:2px; box-shadow:0 0 0 4px var(--ink); }

/* ---------- Navigation ---------- */
.actions{ display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 32px 6px; }
.btn{
  border:0; border-radius:99px; background:var(--ink); color:var(--on-ink);
  font-family:var(--serif); font-size:20px; font-weight:600; padding:14px 32px; cursor:pointer;
}
.btn[disabled]{ opacity:.6; cursor:default; }
.link{
  border:0; background:none; padding:10px 4px; color:var(--soft); cursor:pointer;
  font-family:var(--serif); font-size:18px; font-style:italic;
  text-decoration:underline; text-underline-offset:4px; text-decoration-color:var(--rule);
}
.err{ min-height:24px; margin:0; padding:2px 32px 22px; text-align:right; font-size:16px; font-style:italic; color:var(--error); }

/* ---------- Merci ---------- */
.sparkle{ margin:0; font-family:Georgia, serif; font-size:20px; color:var(--soft); }
.thanks h2{ margin:10px 0 0; font-size:52px; line-height:1; font-style:italic; font-weight:500; }
.thanks p{ margin:16px auto 0; max-width:380px; font-size:19px; line-height:1.45; color:#2E2B27; }
.thanks .sig{ font-style:italic; color:var(--soft); }

/* ---------- Pied de page ---------- */
footer{ margin-top:48px; text-align:center; font-size:14px; line-height:1.6; color:var(--ink-faint); }
footer .a{ display:block; margin-bottom:12px; font-size:30px; font-style:italic; font-weight:500; color:var(--on-ink); }
footer a{ color:var(--ink-soft); }

/* ---------- Mobile ---------- */
@media (max-width:480px){
  .page{ padding:32px 14px 48px; }
  .stub{ padding:24px 20px 20px; gap:16px; }
  .num{ width:50px; font-size:50px; padding-right:14px; }
  .stub h2:focus{ outline:none; }
.stub h2{ font-size:30px; }
  .body{ padding:4px 20px 26px; }
  .actions{ padding:12px 20px 4px; }
  .err{ padding:2px 20px 20px; }
  .cards{ grid-template-columns:1fr; }
  .moment{ grid-template-columns:1fr; }
  .mini span{ min-width:40px; height:40px; }
  .nps{ grid-template-columns:repeat(6, 1fr); gap:6px; }
  .progress li{ font-size:14px; }
}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{ transition:none !important; animation:none !important; }
}
</style>
</head>
<body>
<div class="page" id="app" data-step="1">

  <header class="top">
    <p class="brand">/aeconomia.</p>
    <div class="hero">
      <h1>Merci d’être venus.</h1>
      <p class="lead">Quelques réponses rapides pour que la prochaine soirée vous ressemble encore plus.</p>
      <p class="meta">Environ deux minutes, en quatre étapes</p>
    </div>
  </header>

  <nav class="progress" aria-label="Progression">
    <ol>
      <li data-i="1">Vous</li>
      <li data-i="2">La soirée</li>
      <li data-i="3">La prochaine</li>
      <li data-i="4">La suite</li>
    </ol>
  </nav>

  <form id="survey" novalidate>

    <!-- ÉTAPE 1 : VOUS -->
    <section class="step" data-step="1" aria-labelledby="t1">
      <div class="ticket">
        <div class="stub">
          <span class="num" aria-hidden="true">1</span>
          <div>
            <h2 id="t1">Vous</h2>
            <p>Avec votre nom ou en toute discrétion, c’est vous qui choisissez.</p>
          </div>
        </div>
        <div class="perf" aria-hidden="true"><span></span></div>
        <div class="body">

          <fieldset class="q" id="q-mode">
            <legend>Comment souhaitez-vous répondre&#8239;?</legend>
            <div class="cards">
              <label class="card">
                <input type="radio" name="mode" value="Nominatif">
                <span><strong>Avec mon nom</strong><em>Pour que l’on puisse revenir vers vous</em></span>
              </label>
              <label class="card">
                <input type="radio" name="mode" value="Anonyme">
                <span><strong>Anonymement</strong><em>Seules vos réponses nous parviennent</em></span>
              </label>
            </div>
          </fieldset>

          <div class="reveal" id="ident" hidden>
            <div class="q">
              <label class="label" for="nom">Prénom et nom</label>
              <input type="text" id="nom" name="nom" maxlength="120" autocomplete="name">
            </div>
            <div class="q">
              <label class="label" for="structure">Agence ou cabinet <span class="opt">facultatif</span></label>
              <input type="text" id="structure" name="structure" maxlength="120" autocomplete="organization">
            </div>
          </div>

          <fieldset class="q">
            <legend>Votre activité <span class="opt">facultatif</span></legend>
            <div class="chips">
              <label><input type="radio" name="activite" value="Agent immobilier"><span>Agent immobilier</span></label>
              <label><input type="radio" name="activite" value="Notaire"><span>Notaire</span></label>
              <label><input type="radio" name="activite" value="CGP"><span>Conseiller en patrimoine</span></label>
              <label><input type="radio" name="activite" value="Promoteur / constructeur"><span>Promoteur ou constructeur</span></label>
              <label><input type="radio" name="activite" value="Expert-comptable"><span>Expert-comptable</span></label>
              <label><input type="radio" name="activite" value="Autre"><span>Autre</span></label>
            </div>
          </fieldset>

        </div>
        <div class="perf" aria-hidden="true"><span></span></div>
        <div class="actions">
          <span></span>
          <button type="button" class="btn" data-next>Continuer</button>
        </div>
        <p class="err" role="alert"></p>
      </div>
    </section>

    <!-- ÉTAPE 2 : LA SOIRÉE -->
    <section class="step" data-step="2" aria-labelledby="t2" hidden>
      <div class="ticket">
        <div class="stub">
          <span class="num" aria-hidden="true">2</span>
          <div>
            <h2 id="t2">La soirée</h2>
            <p>Jeudi 5&nbsp;novembre, Empreinte Hôtel.</p>
          </div>
        </div>
        <div class="perf" aria-hidden="true"><span></span></div>
        <div class="body">

          <fieldset class="q" id="q-globale">
            <legend>Dans l’ensemble, comment avez-vous trouvé la soirée&#8239;?</legend>
            <div class="scale">
              <label><input type="radio" name="note_globale" value="1"><span>1</span></label>
              <label><input type="radio" name="note_globale" value="2"><span>2</span></label>
              <label><input type="radio" name="note_globale" value="3"><span>3</span></label>
              <label><input type="radio" name="note_globale" value="4"><span>4</span></label>
              <label><input type="radio" name="note_globale" value="5"><span>5</span></label>
            </div>
            <div class="ends" aria-hidden="true"><span>Décevante</span><span>Excellente</span></div>
          </fieldset>

          <div class="q">
            <span class="label">Et dans le détail&#8239;?</span>
            <p class="hint">De 1 à 5. Passez ce que vous n’avez pas vécu.</p>
            <div class="moments">
              <div class="moment" role="radiogroup" aria-label="L’accueil">
                <div class="name">L’accueil<small>arrivée, informations pratiques</small></div>
                <div class="mini" data-name="note_accueil"></div>
              </div>
              <div class="moment" role="radiogroup" aria-label="L’atelier mixologie">
                <div class="name">L’atelier mixologie</div>
                <div class="mini" data-name="note_atelier" data-na="Pas participé"></div>
              </div>
              <div class="moment" role="radiogroup" aria-label="Le buffet">
                <div class="name">Le buffet</div>
                <div class="mini" data-name="note_buffet"></div>
              </div>
              <div class="moment" role="radiogroup" aria-label="Le lieu et l’ambiance">
                <div class="name">Le lieu et l’ambiance</div>
                <div class="mini" data-name="note_lieu"></div>
              </div>
              <div class="moment" role="radiogroup" aria-label="Les rencontres">
                <div class="name">Les rencontres<small>avec l’équipe et les autres invités</small></div>
                <div class="mini" data-name="note_rencontres"></div>
              </div>
            </div>
          </div>

          <fieldset class="q">
            <legend>La durée, de 19h à 23h, était…</legend>
            <div class="chips">
              <label><input type="radio" name="duree" value="Trop courte"><span>Trop courte</span></label>
              <label><input type="radio" name="duree" value="Juste bien"><span>Juste bien</span></label>
              <label><input type="radio" name="duree" value="Trop longue"><span>Trop longue</span></label>
            </div>
          </fieldset>

        </div>
        <div class="perf" aria-hidden="true"><span></span></div>
        <div class="actions">
          <button type="button" class="link" data-prev>Retour</button>
          <button type="button" class="btn" data-next>Continuer</button>
        </div>
        <p class="err" role="alert"></p>
      </div>
    </section>

    <!-- ÉTAPE 3 : LA PROCHAINE -->
    <section class="step" data-step="3" aria-labelledby="t3" hidden>
      <div class="ticket">
        <div class="stub">
          <span class="num" aria-hidden="true">3</span>
          <div>
            <h2 id="t3">La prochaine</h2>
            <p>Aidez-nous à choisir le bon moment et le bon format.</p>
          </div>
        </div>
        <div class="perf" aria-hidden="true"><span></span></div>
        <div class="body">

          <fieldset class="q">
            <legend>À quel rythme aimeriez-vous nous retrouver&#8239;?</legend>
            <div class="chips">
              <label><input type="radio" name="frequence" value="1 fois par an"><span>Une fois par an</span></label>
              <label><input type="radio" name="frequence" value="2 fois par an"><span>Deux fois par an</span></label>
              <label><input type="radio" name="frequence" value="Chaque trimestre"><span>Chaque trimestre</span></label>
            </div>
          </fieldset>

          <fieldset class="q">
            <legend>Le moment idéal pour vous</legend>
            <div class="chips">
              <label><input type="radio" name="moment" value="Déjeuner"><span>Un déjeuner</span></label>
              <label><input type="radio" name="moment" value="Afterwork 18h-20h"><span>Un afterwork, 18h–20h</span></label>
              <label><input type="radio" name="moment" value="Soirée 19h-23h"><span>Une soirée, 19h–23h</span></label>
            </div>
          </fieldset>

          <fieldset class="q">
            <legend>Les jours qui vous arrangent <span class="opt">plusieurs choix</span></legend>
            <div class="chips">
              <label><input type="checkbox" name="jours" value="Mardi"><span>Mardi</span></label>
              <label><input type="checkbox" name="jours" value="Mercredi"><span>Mercredi</span></label>
              <label><input type="checkbox" name="jours" value="Jeudi"><span>Jeudi</span></label>
              <label><input type="checkbox" name="jours" value="Vendredi"><span>Vendredi</span></label>
            </div>
          </fieldset>

          <fieldset class="q">
            <legend>Les formats qui vous tenteraient <span class="opt">plusieurs choix</span></legend>
            <div class="chips">
              <label><input type="checkbox" name="format" value="Soirée cocktail"><span>Une soirée comme celle-ci</span></label>
              <label><input type="checkbox" name="format" value="Dégustation"><span>Une dégustation, vin ou chocolat</span></label>
              <label><input type="checkbox" name="format" value="Activité sportive"><span>Golf, padel…</span></label>
              <label><input type="checkbox" name="format" value="Atelier culinaire"><span>Un atelier culinaire</span></label>
              <label><input type="checkbox" name="format" value="Conférence + cocktail"><span>Une conférence suivie d’un cocktail</span></label>
            </div>
          </fieldset>

          <fieldset class="q">
            <legend>Le cadeau avec lequel vous aimeriez repartir <span class="opt">deux choix maximum</span></legend>
            <div class="chips" data-max="2" id="goodies">
              <label><input type="checkbox" name="goodies" value="Carnet et stylo"><span>Un beau carnet et son stylo</span></label>
              <label><input type="checkbox" name="goodies" value="Gourde ou mug isotherme"><span>Une gourde ou un mug isotherme</span></label>
              <label><input type="checkbox" name="goodies" value="Batterie nomade"><span>Une batterie nomade</span></label>
              <label><input type="checkbox" name="goodies" value="Tote bag"><span>Un tote bag</span></label>
              <label><input type="checkbox" name="goodies" value="Coffret gourmand"><span>Un coffret gourmand</span></label>
              <label><input type="checkbox" name="goodies" value="Bouteille de vin"><span>Une bouteille de vin</span></label>
              <label><input type="checkbox" name="goodies" value="Bougie ou plante"><span>Une bougie ou une plante</span></label>
              <label><input type="checkbox" name="goodies" value="Autre" data-other><span>Autre idée</span></label>
              <label><input type="checkbox" name="goodies" value="Aucun" data-none><span>Pas de cadeau, merci</span></label>
            </div>
            <div class="reveal" id="goodies-other" hidden>
              <label class="sr" for="goodies_autre">Votre idée de cadeau</label>
              <input type="text" id="goodies_autre" name="goodies_autre" maxlength="120" placeholder="Votre idée">
            </div>
          </fieldset>

        </div>
        <div class="perf" aria-hidden="true"><span></span></div>
        <div class="actions">
          <button type="button" class="link" data-prev>Retour</button>
          <button type="button" class="btn" data-next>Continuer</button>
        </div>
        <p class="err" role="alert"></p>
      </div>
    </section>

    <!-- ÉTAPE 4 : LA SUITE -->
    <section class="step" data-step="4" aria-labelledby="t4" hidden>
      <div class="ticket">
        <div class="stub">
